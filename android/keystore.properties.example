# Copy this file to android/keystore.properties and replace every placeholder.
# The real file is ignored by git. Never commit passwords or the upload keystore.
storeFile=C:/secure/path/outside-the-repository/leftly-upload.jks
storePassword=CHOOSE_A_STRONG_STORE_PASSWORD
keyAlias=YOUR_UPLOAD_KEY_ALIAS
keyPassword=CHOOSE_A_STRONG_KEY_PASSWORD
